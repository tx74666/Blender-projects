# Blender automatic backups
*.blend1
*.blend2
*.blend@

# Temporary/cache outputs
*.tmp
cache/
renders/

# Python add-on caches
__pycache__/
*.py[cod]

# Downloaded/reference assets are kept local until their license is reviewed.
assets/

# Local recovery, generated validation results, and old add-on packages.
# These remain on disk; they are not project deliverables.
/.codex-backups/
/.character_designer_backups/
/.codex-package/
/outputs/
/task_artifacts/
/Previews/
/dist/

# Publish Character X and its packaged animation library. Backups stay local.
*.blend
!/X.blend
*.blend[0-9]
*.blend[0-9][0-9]
*.zip
*.log
*~

# Generated validation runtime and cloth bake caches remain available on disk.
# Scripts, reports, and raw replay inputs are still eligible for upload.
/validation/**/native_temp/
/validation/**/native_cache/
/validation/**/blendcache_*/

# Local Codex diagnostic tools, task staging, and recovery stay on this PC.
/.codex/

# Full historical report data is compressed locally; upload its small summary.
/.validation-archives/

# Exact persistent libraries required by the saved X.blend backup.
!/project_dependencies/libraries/*.blend

# Local Unity validation caches and per-user settings.
# Other paths continue to follow the existing rules.
/validation/**/UnityPreview*/[Ll]ibrary/
/validation/**/UnityPreview*/[Tt]emp/
/validation/**/UnityPreview*/[Ll]ogs/
/validation/**/UnityPreview*/[Oo]bj/
/validation/**/UnityPreview*/[Uu]serSettings/
/validation/**/unity_play_*/Project/[Ll]ibrary/
/validation/**/unity_play_*/Project/[Tt]emp/
/validation/**/unity_play_*/Project/[Ll]ogs/
/validation/**/unity_play_*/Project/[Oo]bj/
/validation/**/unity_play_*/Project/[Uu]serSettings/

# Validation runs include full add-on copies. Publish selected evidence explicitly.
/validation/*/
# Historical local recovery bundle and retired desktop shortcuts.
/Archive/Retired_X_20261109_01/
/project_dependencies/manifest.json
/project_dependencies/README.txt
/project_dependencies/Cosha_Walk_N.cdanim.json
# Derived textures are extracted from the saved scene during restore.
/project_dependencies/restored_textures/
# Authored Gun Follow example scene.
!/Gun_Follow_Demo/Gun_Follow_Cosha_live.blend
/project_dependencies/libraries/15e35a473061412db3034d6f5819d00c.blend
/project_dependencies/libraries/592a720c04fb4d8fa8f87b2dcc44f33b.blend
