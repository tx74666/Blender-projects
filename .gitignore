# Blender automatic backups
*.blend1
*.blend2
*.blend@

# Temporary/cache outputs
*.tmp
cache/
renders/

# Python add-on caches
__pycache__/
*.py[cod]

# Downloaded/reference assets are kept local until their license is reviewed.
assets/

# Local recovery, generated validation results, and old add-on packages.
# These remain on disk; they are not project deliverables.
/.codex-backups/
/.character_designer_backups/
/.codex-package/
/outputs/
/task_artifacts/
/Previews/
/dist/

# Publish the two main scenes only. Backups/experiments must stay local.
*.blend
!/X.blend
!/Build.blend
*.blend[0-9]
*.blend[0-9][0-9]
*.zip
*.log
*~

# Generated validation runtime and cloth bake caches remain available on disk.
# Scripts, reports, and raw replay inputs are still eligible for upload.
/validation/**/native_temp/
/validation/**/native_cache/
/validation/**/blendcache_*/
