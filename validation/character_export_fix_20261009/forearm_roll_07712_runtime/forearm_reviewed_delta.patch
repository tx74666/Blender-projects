 from __future__ import annotations
 
 import math
+import hashlib
 
 _EPSILON = 1.0e-8
 _END_PADDING = 0.08
 _RING_END_PADDING = 0.025
 _MAX_AXIAL_SPREAD = 0.20
 _MAX_EDGE_AXIAL_COSINE = 0.60
+
